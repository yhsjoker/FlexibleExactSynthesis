{
  // Run with: ./build/fes_app benchmark --config config/benchmark_default.json
  "command": "benchmark",
  "run": {
    "resume_policy": "run_all",
    "case_timeout_ms": 0,
    // Parsed for consistency. The current physical evaluator does not use this
    // field to parallelize per-benchmark cases.
    "threads": 0
  },
  "benchmark": {
    // Replace with an absolute path or a project-root-relative benchmark directory.
    "benchmark_dir": "benchmarks",
    // Empty string selects the newest generated library under results_repo.
    "library_dir": "",
    "verify": false,
    "mode": "standard"
  }
}
