{
  // Primary full-library generation config.
  // Run with: ./build/fes_app generate --config config/build_library.json
  "command": "generate",
  "dependencies": {
    // Replace this with your ABC binary. Relative paths are project-root-relative.
    "abc_path": "third_party/abc/abc",
    "python_script": "scripts/single_power_run.py",
    "genlib_path": "resources/nangate_45nm.genlib",
    "liberty_path": "resources/NangateOpenCellLibrary_typical.lib",
    "standard_cell_csv": "resources/standard_cells.csv"
  },
  "run": {
    // Resume is the practical default for the full build because generation is long.
    "resume_policy": "resume",
    "case_timeout_ms": 0,
    "threads": 0
  },
  "generate": {
    "k": 4,
    // 0 means no positive truncation. In exhaustive mode this builds every
    // NPN-canonical representative selected by buildExhaustiveFunctionSet().
    "num_functions": 0,
    "function_source": "exhaustive",
    // Relative output_dir resolves to <project_root>/results_repo/library_k4_npn_cartesian.
    "output_dir": "library_k4_npn_cartesian",
    // Enables CEC for accepted synthesized circuits.
    "verify": true,
    "timeouts_ms": {
      "sat": 10000,
      "optimization": 60000,
      "case": 0
    },
    "activity": {
      // 4 levels across 4 inputs gives 4^4 = 256 activity patterns per function.
      "mode": "cartesian",
      "levels": [0.2, 0.4, 0.6, 0.8]
    }
  }
}
