{
  // Run with: ./build/fes_app generate --config config/generate_benchmark_k4_cartesian.json
  "command": "generate",
  "run": {
    "resume_policy": "resume",
    "case_timeout_ms": 0,
    "threads": 0
  },
  "generate": {
    "k": 4,
    "num_functions": 32,
    "function_source": "benchmark",
    // Replace with an absolute path or a project-root-relative benchmark directory.
    "benchmark_dir": "benchmarks",
    "output_dir": "benchmark_k4_cartesian",
    "verify": false,
    "timeouts_ms": {
      "sat": 10000,
      "optimization": 60000,
      "case": 0
    },
    "activity": {
      "mode": "cartesian",
      "levels": [0.2, 0.4, 0.6, 0.8]
    }
  }
}
